global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['{{ nas_ip }}:{{ alertmanager_port }}']

scrape_configs:
  - job_name: 'node'
    static_configs:
      - targets: ['{{ nas_ip }}:{{ node_exporter_port }}']
        labels:
          server: nas
      - targets: ['{{ minisforum_host }}:{{ node_exporter_port }}']
        labels:
          server: minisforum

  - job_name: 'docker-containers'
    static_configs:
{% for host in groups['all'] %}
      - targets: ['{{ hostvars[host].ansible_host | default(host) }}:{{ cadvisor_port }}']
        labels:
          server: '{{ host }}'
{% endfor %}

  - job_name: 'wud'
    basic_auth:
      username: {{ npm_admin_email | to_json }}
      password_file: /etc/prometheus/secrets/wud-password
    static_configs:
      - targets: ['{{ nas_ip }}:{{ wud_port }}']
        labels:
          server: nas
      - targets: ['{{ minisforum_host }}:{{ wud_agent_port }}']
        labels:
          server: minisforum

  - job_name: 'docker-status'
    static_configs:
{% for host in groups['all'] %}
      - targets: ['{{ hostvars[host].ansible_host | default(host) }}:{{ docker_exporter_port }}']
        labels:
          server: '{{ host }}'
{% endfor %}
