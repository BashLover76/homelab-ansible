#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import tempfile
import time
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PROMETHEUS_URL = os.environ.get("PROMETHEUS_URL", "http://NAS_IP:9090").rstrip("/")
UPDATE_TOKEN = os.environ["UPDATE_TOKEN"]


def run(argv, check=True):
    completed = subprocess.run(argv, text=True, capture_output=True)
    if check and completed.returncode != 0:
        raise RuntimeError((completed.stderr or completed.stdout or "command failed").strip())
    return completed


def query_prometheus(query):
    data = urllib.parse.urlencode({"query": query}).encode()
    with urllib.request.urlopen(f"{PROMETHEUS_URL}/api/v1/query", data=data, timeout=15) as response:
        payload = json.load(response)
    if payload.get("status") != "success":
        raise RuntimeError(json.dumps(payload))
    return payload["data"]["result"]


def inspect_container(name):
    out = run(["docker", "inspect", name]).stdout
    return json.loads(out)[0]


def image_info(image):
    out = run(["docker", "image", "inspect", image]).stdout
    return json.loads(out)[0]


def pull_digest_image(image):
    run(["docker", "pull", image])
    info = image_info(image)
    digest = info["RepoDigests"][0].split("@", 1)[1]
    return f"{image}@{digest}", info["Id"]


def wait_healthy(name, attempts=24):
    for _ in range(attempts):
        info = inspect_container(name)
        state = info["State"]
        health = state.get("Health", {})
        if state["Status"] == "running" and health.get("Status", "healthy") == "healthy":
            return info
        time.sleep(5)
    raise RuntimeError(f"{name} is not healthy")


def update_alertmanager(metric):
    result_tag = metric["result_tag"]
    if not result_tag.startswith("v"):
        raise RuntimeError(f"Unsupported Alertmanager tag: {result_tag}")
    return {"service": "alertmanager", "status": "manual-contract-only", "tag": result_tag}


def run_updates():
    results = []
    metrics = query_prometheus('wud_containers{server="nas",update_available="true"}')
    for item in metrics:
        metric = item["metric"]
        name = metric.get("name")
        if name == "alertmanager":
            results.append(update_alertmanager(metric))
        else:
            results.append({"service": name, "status": "notification-only"})
    return {"updates_seen": len(metrics), "results": results}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        print("%s - %s" % (self.address_string(), fmt % args), flush=True)

    def respond(self, status, payload):
        body = json.dumps(payload, sort_keys=True).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/healthz":
            self.respond(200, {"status": "ok"})
            return
        self.respond(404, {"error": "not found"})

    def do_POST(self):
        if self.path != "/run":
            self.respond(404, {"error": "not found"})
            return
        if self.headers.get("X-Homelab-Token") != UPDATE_TOKEN:
            self.respond(403, {"error": "forbidden"})
            return
        try:
            self.respond(200, run_updates())
        except Exception as exc:
            self.respond(500, {"error": str(exc)})


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", 8765), Handler).serve_forever()
