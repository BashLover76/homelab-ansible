class Handler(BaseHTTPRequestHandler):
    def respond(self, status, body, content_type="application/json"):
        raw = body if isinstance(body, bytes) else body.encode()
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        if self.path == "/" or self.path.startswith("/dashboard"):
            self.respond(200, HTML, "text/html; charset=utf-8")
            return
        if self.path.startswith("/api/dashboard"):
            try:
                force = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("force") == ["1"]
                self.respond(200, json.dumps(api_payload(force=force)))
            except Exception as exc:
                self.respond(500, json.dumps({"error": str(exc)}))
            return
        self.respond(404, json.dumps({"error": "not found"}))

    def do_HEAD(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", 8780), Handler).serve_forever()
