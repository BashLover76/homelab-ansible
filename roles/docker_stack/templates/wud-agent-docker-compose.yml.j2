name: wud-agent-stack

services:
  wud-agent:
    image: getwud/wud:latest
    container_name: wud-agent
    restart: unless-stopped
    ports:
      - "{{ wud_agent_port }}:3000"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      - WUD_AUTH_ADMIN_USER={{ npm_admin_email }}
      - WUD_AUTH_ADMIN_PASSWORD={{ homelab_admin_password }}
      - WUD_WATCHER_LOCAL_SOCKET=/var/run/docker.sock
      - WUD_WATCHER_LOCAL_WATCHBYDEFAULT=true
      - WUD_WATCHER_LOCAL_WATCHDIGESTDEFAULT=true
    profiles: ["minisforum"]
